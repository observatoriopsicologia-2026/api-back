{
  "name": "@observatorio-pot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "verify": "npm run coverage && npm run build",
    "storage:check": "npm run build && node scripts/check-r2.mjs",
    "dev": "npm run build && node --watch dist/index.js",
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/index.js",
    "start:prod": "node dist/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:setup": "npm run build && node dist/setup-db.js",
    "dataset:import": "npm run build && node dist/import-dataset.js",
    "test:build": "tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test \".test-dist/tests/**/*.test.js\"",
    "coverage": "npm run test:build && c8 --check-coverage --lines 80 --functions 80 --branches 80 --statements 80 --include \".test-dist/src/**/*.js\" --exclude \".test-dist/src/index.js\" --exclude \".test-dist/src/config.js\" --exclude \".test-dist/tests/**/*.js\" node --test \".test-dist/tests/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@supabase/supabase-js": "^2.49.4",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "pg": "^8.14.1",
    "swagger-jsdoc": "6.3.0",
    "swagger-ui-express": "5.0.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "swagger-jsdoc": {
      "glob": "14.0.2"
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@types/swagger-jsdoc": "6.0.4",
    "@types/swagger-ui-express": "4.1.8",
    "c8": "^11.0.0",
    "typescript": "^5.8.2"
  }
}
