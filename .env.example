NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:4200
JWT_SECRET=dev-only-change-me

# Use the Supabase session pooler URI. Never commit a real password.
DATABASE_URL=
# Optional override: the public Supabase Root 2021 CA is already bundled.
# Literal \n is supported for a custom dashboard value.
DATABASE_SSL_CA=

# Local development only. Use r2 in production.
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
# Private Cloudflare R2 bucket. These keys belong ONLY in the backend.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=observatorio-pdfs
# Legacy Supabase Storage mode remains supported.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLICATION_BUCKET=publications

# Optional initial administrator, only when creating a new database.
ADMIN_NAME=Administrador POT
ADMIN_EMAIL=
ADMIN_PASSWORD=
